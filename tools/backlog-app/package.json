{
  "name": "tandem-backlog-app",
  "version": "0.1.0",
  "private": true,
  "description": "Localhost web application that steers Tandem Commander development through the backlog (feature 344).",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0 || ^26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "node --watch-path=packages/server/src --watch-path=packages/shared/src packages/server/src/main.ts --dev --root ../..",
    "build": "npm run build --workspace @backlog-app/web",
    "start": "node packages/server/src/main.ts --root ../..",
    "typecheck": "tsc -p . && tsc -p packages/shared && tsc -p packages/server && tsc -p packages/web",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
