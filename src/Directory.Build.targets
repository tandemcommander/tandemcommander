<?xml version="1.0" encoding="utf-8"?>
<!--
  Feature 023: Clean Release build output (no Intermediate directory).

  Every project sets IntDir to a folder *inside* its Release output directory
  (typically "$(OutDir)Intermediate\"), which litters the shipped output tree
  (…\tandemcommander\Release_<plat>\) with build scaffolding. For Release only, this
  file relocates each such intermediate directory to a sibling "obj\" root that
  lives OUTSIDE the shipped output tree, by rewriting only the output-tree root
  segment of IntDir and preserving the project's existing (already unique)
  relative sub-path. Because String.Replace is a no-op when the token is absent,
  projects whose intermediates are not under the tandemcommander output tree (e.g.
  the setup\ projects) are left untouched. Debug is intentionally not modified,
  so incremental development and its Intermediate layout stay exactly as before.

  This is imported after every project's property sheets (Microsoft.Cpp.targets
  imports Directory.Build.targets last), so this assignment wins over the value
  set in the per-project *.props files. Relocating (rather than deleting)
  intermediates keeps incremental Release builds fast: the object/PCH cache
  simply moves, it is not discarded.

  KEEP IN SYNC (feature 039b): the "tandemcommander\..." literal below MUST match
  the output-root segment spelled by every <OutDir> in src\**\*_base.props. It
  is a STRING MATCH, and String.Replace is a silent no-op on mismatch: if the
  two ever drift, this line quietly stops firing, Release intermediates go back
  inside the shipped tree, and build.cmd's :clean_release_tree then deletes the
  live object/PCH cache after every build. Nothing errors; builds just become
  from-scratch forever. If you rename the output directory again, grep for the
  old segment across *.props/*.targets/*.vcxproj and confirm zero hits remain.
  (src\plugins\pictview\vcxproj\salpvenv_base.props hardcodes _x64 while
  importing x86.props, so its IntDir never matches this token: a dormant
  instance of exactly that drift. Its project is not in salamand.sln.)
-->
<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IntDir>$(IntDir.Replace('tandemcommander\$(Configuration)_$(ShortPlatform)\', 'obj\$(Configuration)_$(ShortPlatform)\'))</IntDir>
  </PropertyGroup>
  <!--
    Feature 050: keep linker byproducts out of the shipped Release tree.

    The import library (and the .exp the linker always emits next to it) and
    the PDB default to $(OutDir), i.e. straight into the shipped output tree.
    Nothing in the solution links against these import libraries by path
    (sqlite.dll/7za.dll are loaded dynamically), so they are pure byproducts
    there; the PDBs are wanted for crash-dump symbolication but must not
    ship. Redirect both into $(IntDir) - already relocated OUTSIDE the
    shipped tree by the IntDir rewrite above - instead of deleting them
    post-build: .lib/.pdb are tracked link outputs, and deleting them would
    mark every DLL project out-of-date and force a full LTCG relink on each
    incremental Release build. build.cmd :clean_release_tree still deletes
    any stray *.pdb/*.lib/*.exp as a safety net for pre-existing trees.
    Debug is intentionally untouched, like the IntDir rewrite above.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <Link>
      <ImportLibrary>$(IntDir)$(TargetName).lib</ImportLibrary>
      <ProgramDatabaseFile>$(IntDir)$(TargetName).pdb</ProgramDatabaseFile>
    </Link>
  </ItemDefinitionGroup>
  <!--
    Feature 167: Control Flow Guard for every Release binary (076 review, section 3.4: DEP, ASLR
    and high-entropy VA were on, CFG was not - part of the hardening score vendors publish). The
    compiler instruments indirect calls, the linker marks the image (DLL characteristic
    GUARD_CF). Release only: /guard:cf does not combine with Debug's /ZI (Edit and Continue).
    A project linked without the CRT has no load configuration for the guard (LNK4266) - the flag
    would be set without effect; such a project sets TcNoControlFlowGuard (fcremote).
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release' and '$(TcNoControlFlowGuard)' != 'true'">
    <ClCompile>
      <ControlFlowGuard>Guard</ControlFlowGuard>
    </ClCompile>
    <Link>
      <AdditionalOptions>%(AdditionalOptions) /guard:cf</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
