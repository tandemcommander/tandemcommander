// defines for SALAMAND.EXE and ENGLISH.SLG VERSIONINFO
// look at shared\versinfo.rc

// WARNING: cannot be replaced by "#pragma once" because it is included from .rc file and it seems resource compiler does not support "#pragma once"
#ifndef __VERSINFO_RH2
#define __VERSINFO_RH2

#if defined(APSTUDIO_INVOKED) && !defined(APSTUDIO_READONLY_SYMBOLS)
#error this file is not editable by Microsoft Visual C++
#endif //defined(APSTUDIO_INVOKED) && !defined(APSTUDIO_READONLY_SYMBOLS)

#include "plugins\shared\spl_vers.h" // vytahneme cisla verzi + buildu

#define VERSINFO_MAJOR       VERSINFO_SALAMANDER_MAJOR
#define VERSINFO_MINORA      VERSINFO_SALAMANDER_MINORA
#define VERSINFO_MINORB      VERSINFO_SALAMANDER_MINORB
#define VERSINFO_VERSION     VERSINFO_SALAMANDER_VERSION

// LegalCopyright metadata written to the version resource. Not displayed
// anywhere in the UI -- the two defines below are what the user sees.
#define VERSINFO_COPYRIGHT   "Copyright © 1997-2026 Open Salamander Authors, © 2026 " VERSINFO_HOLDER_TANDEM
// The two notices displayed by the splash screen and the About dialog
// (feature 040). This project's holder first, Open Salamander second, on both
// surfaces. Each line is self-contained English and is NEVER routed through
// the translation pipeline -- the About dialog controls carry an empty caption
// in lang.rc and are filled at run time from these defines.
// The copyright-year rule updates all three defines here together; the holder
// name itself lives in VERSINFO_HOLDER_TANDEM (plugins\shared\spl_vers.h) and is
// shared with every plugin and standalone .rc.
#define VERSINFO_COPYRIGHT_TANDEM     "Copyright © 2026 " VERSINFO_HOLDER_TANDEM
#define VERSINFO_COPYRIGHT_OPENSAL  "Copyright © 1997-2026 Open Salamander Authors"
#define VERSINFO_COMPANY     "Tandem Commander Project"

#ifdef TC_PORTABLE // feature 428: the executable of the portable edition says so in its properties
#define VERSINFO_DESCRIPTION "Tandem Commander, File Manager (portable)"
#else
#define VERSINFO_DESCRIPTION "Tandem Commander, File Manager"
#endif
#define VERSINFO_COMMENT     "A small and fast two-pane file manager with open plugin architecture."

#ifdef _LANG
#define VERSINFO_INTERNAL    "ENGLISH"
#define VERSINFO_ORIGINAL    VERSINFO_INTERNAL ".SLG"
#else
#define VERSINFO_INTERNAL    "TANDEMCOMMANDER"
#define VERSINFO_ORIGINAL    VERSINFO_INTERNAL ".EXE"
#endif

// for SLG translators
#define VERSINFO_SLG_WEB     "tandemcommander.org"
#define VERSINFO_SLG_COMMENT "English version"

#endif // __VERSINFO_RH2
